# Groq API (reranking model - free tier)
# Lấy key tại: https://console.groq.com/keys
GROQ_API_KEY=

# Hugging Face API (embedding model - free tier)
# Lấy key tại: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=

# MiniMax API (embedding model - alternative)
# Lấy key tại: https://platform.minimaxi.com/
MINIMAX_API_KEY=

# Gemini (fallback - không bắt buộc)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Realtime capture (Discord bot → web demo)
# Token lấy từ https://discord.com/developers/applications
DISCORD_BOT_TOKEN=
# URL app chạy web demo (mặc định localhost:3000)
REALTIME_API_URL=http://localhost:3000
# Token chia sẻ giữa bot và app. Bắt buộc khi deploy (optional local).
# Bot gửi kèm header: x-ingest-token: <REALTIME_INGEST_TOKEN>
REALTIME_INGEST_TOKEN=
# Optional: chỉ capture các channel có tên (phân cách bằng dấu phẩy). Để trống = tất cả
REALTIME_ALLOWED_CHANNELS=

# Demo document ingest (server test → /api/demo/documents)
# Bật/tắt bắt link trong message Discord để xử lý vào dataset demo.
DEMO_DOCUMENT_INGEST=true
# Token riêng cho dataset demo. Không dùng chung REALTIME_INGEST_TOKEN.
DEMO_DOCUMENT_INGEST_TOKEN=
# Optional: chỉ ingest URL thuộc các domain này (phân cách dấu phẩy). Để trống = tất cả http(s).
DEMO_DOCUMENT_DOMAINS=
